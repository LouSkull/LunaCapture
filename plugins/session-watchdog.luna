// =============================================================================
//  Luna Capture — SESSION WATCHDOG
//  Tells you the moment a long recording or Replay session goes wrong.
// =============================================================================
//
//  WHY THIS IS USEFUL
//
//  A recording that silently degrades is the worst outcome: you find out hours
//  later that the footage is a recovery card. Luna already recovers on its own,
//  but if you are mid-session — or the main window is hidden in the tray — you
//  never see it happen.
//
//  This plugin turns the quiet health events into overlay toasts, so a capture
//  hiccup is something you notice immediately instead of discovering later.
//
//  It changes nothing about how capture behaves — it only reports.
//
//  INSTALL
//    Copy to %LOCALAPPDATA%\Luna Capture\Plugins\ then Plugins -> Reload.
//
// =============================================================================

luna 1;

plugin "luna.base.session-watchdog" {
    name        "Session Watchdog";
    version     "1.0.0";
    author      "Luna Capture";
    description "Surfaces recording and Replay recovery, failure and save events as overlay toasts.";
    requires host_api 5;

    permission notifications;

    // --- Capture source lost / restored --------------------------------------
    on recording_recovering {
        notify "Capture interrupted" "The recorder lost the display and is retrying. The timeline keeps running.";
    }

    on recording_recovered {
        notify "Capture restored" "The display reconnected and real frames are being written again.";
    }

    on replay_recovering {
        notify "Replay interrupted" "A Replay channel lost its display and is retrying automatically.";
    }

    on replay_recovered {
        notify "Replay restored" "The Replay channel reconnected without resetting the buffer.";
    }

    // --- Terminal failures ----------------------------------------------------
    on recording_failed {
        notify "Recording failed" "The recording could not be finalized. Check the Record page for details.";
    }

    on replay_failed {
        notify "Replay failed" "A Replay channel stopped with an error. Check the Replay page for details.";
    }

    on capture_failed {
        notify "Capture failed" "The screenshot request was rejected. Future captures remain available.";
    }

    // --- Confirmations you can act on ----------------------------------------
    on recording_saved {
        notify "Recording saved" "The file finished writing and is ready in the recordings folder.";
    }

    on replay_saved {
        notify "Replay saved" "The buffered clip was written and the buffer restarted at 0:00.";
    }
}

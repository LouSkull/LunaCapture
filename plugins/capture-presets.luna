// =============================================================================
//  Luna Capture — CAPTURE PRESETS
//  Switch the whole capture pipeline between three real-world jobs.
// =============================================================================
//
//  WHY THIS IS USEFUL
//
//  The right settings for a clip you are about to upload are not the right
//  settings for footage you want to keep, and neither matches what you want
//  when you are firing off screenshots into a chat. Changing five fields by
//  hand every time is why people just leave one compromise setting on.
//
//  Each command below applies one complete, coherent bundle in a single press.
//  Tune the numbers to your hardware — they are ordinary settings, not magic.
//
//  IMPORTANT
//
//  Encoder settings are locked while a recording or Replay session is live.
//  Stop the session first, then apply a preset. Luna will report the block
//  rather than silently ignoring it.
//
//  Ranges accepted by the host:
//    recording_height   0 (native) .. 4320
//    recording_fps      1 .. 240
//    video_bitrate      1 .. 200      (Mbps)
//    audio_bitrate      96, 128, 160 or 192  (kbps)
//    jpeg_quality       1 .. 100
//    replay_seconds     5 .. 3600
//    codec              h264 | hevc | av1 | vp9 | h264_fragmented | hevc_fragmented
//                       | mpeg4 | h263 | wmv9 | vc1 | mjpeg | h264_avi
//                       (the container and file extension follow the codec)
//    image_format       png | jpeg
//
//  INSTALL
//    Copy to %LOCALAPPDATA%\Luna Capture\Plugins\ then Plugins -> Reload.
//
// =============================================================================

luna 1;

plugin "luna.base.capture-presets" {
    name        "Capture Presets";
    version     "1.0.0";
    author      "Luna Capture";
    description "One-press setting bundles for sharing clips, archiving footage, and fast screenshots.";
    requires host_api 5;

    permission settings;
    permission notifications;

    // --- Small files that upload fast, still 1080p60 -------------------------
    command "preset-share" {
        title       "Preset: share";
        description "1080p60 H.264 at a modest bitrate — small files for Discord and uploads.";
        icon        "video";
        surface     tray;
        order       110;
        run {
            setting recording_height 1080;
            setting recording_fps 60;
            setting codec h264;
            setting video_bitrate 12;
            setting audio_bitrate 160;
            setting replay_seconds 60;
            notify "Preset: share" "1080p60 H.264 - 12 Mbps - 60s Replay buffer.";
        }
    }

    // --- Keep everything, quality first --------------------------------------
    command "preset-archive" {
        title       "Preset: archive";
        description "Native resolution HEVC at a high bitrate — best quality to keep.";
        icon        "record";
        surface     tray;
        order       120;
        run {
            setting recording_height 0;
            setting recording_fps 60;
            setting codec hevc;
            setting video_bitrate 45;
            setting audio_bitrate 192;
            setting replay_seconds 120;
            notify "Preset: archive" "Native resolution HEVC - 45 Mbps - 120s Replay buffer.";
        }
    }

    // --- Screenshots meant to be pasted straight into a chat -----------------
    command "preset-screenshots-fast" {
        title       "Preset: fast screenshots";
        description "JPEG output and clipboard copy — smallest files, instant sharing.";
        icon        "photo";
        surface     tray;
        order       130;
        run {
            setting image_format jpeg;
            setting jpeg_quality 90;
            setting copy_region on;
            setting output_width 0;
            setting output_height 0;
            notify "Preset: fast screenshots" "JPEG at quality 90, region copied to the clipboard.";
        }
    }

    // --- Back to lossless screenshots ----------------------------------------
    command "preset-screenshots-lossless" {
        title       "Preset: lossless screenshots";
        description "PNG output at native resolution — for text, UI and documentation.";
        icon        "photo";
        surface     tray;
        order       140;
        run {
            setting image_format png;
            setting output_width 0;
            setting output_height 0;
            notify "Preset: lossless screenshots" "PNG at native resolution.";
        }
    }
}

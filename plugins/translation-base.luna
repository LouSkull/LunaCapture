// =============================================================================
//  Luna Capture — TRANSLATION BASE
//  Every user-facing string in the application, ready to translate.
// =============================================================================
//
//  HOW TO MAKE A TRANSLATION
//
//  1. Copy this file and rename it, e.g. luna-russian.luna
//  2. Change the plugin id below so it does not collide with other plugins,
//     e.g. "luna.locale.ru-RU"
//  3. Change the locale name to your language tag, e.g. locale "ru-RU"
//  4. Translate ONLY the right-hand side of every "..." = "..." pair.
//     The LEFT side must stay byte-for-byte identical to the English text —
//     it is the lookup key the host matches against.
//  5. Save the file as UTF-8 into:
//         %LOCALAPPDATA%\Luna Capture\Plugins\
//  6. Open Luna Capture -> Plugins -> Reload, enable the plugin, then use
//     its Manage menu to activate the locale.
//
//  NOTES
//
//  * Entries you have not translated yet can stay as they are (English =
//    English). The file works at any level of completeness, so you can
//    translate gradually and reload as you go.
//  * Strings containing {0} or {1} are TEMPLATES. The placeholder is filled in
//    by the app at runtime (a file name, a monitor number, a count). Keep the
//    placeholders in your translation; you may reorder them.
//  * Only these escapes are legal: \n, \t, \\ and \" — keep them intact.
//  * A locale may hold at most 1024 entries and each string is limited to
//    512 characters. This file uses 733 entries, leaving room for growth.
//  * Many strings are short UI labels drawn into fixed-width native controls.
//    The interface does not reflow, so prefer a translation of similar length
//    and check it in the app.
//  * Codec and unit tokens such as "H.264", "AV1", " ms" and " dB" are listed
//    for completeness — leaving them unchanged is usually correct.
//
// =============================================================================

luna 1;

plugin "luna.base.translation" {
    name        "Translation Base";
    version     "1.0.0";
    author      "Luna Capture";
    description "Every user-facing string in Luna Capture, ready to translate into any language.";
    requires host_api 5;

    permission localization;

    // Change "en-US" to your language tag, for example "ru-RU", "de-DE", "pt-BR".
    locale "en-US" {

    // ---------------------------------------------------------------------
    // Main window, pages, dialogs, status lines and toasts  (632 strings)
    // ---------------------------------------------------------------------
    "No screenshots yet" = "No screenshots yet";
    "quick panel toggle" = "quick panel toggle";
    "active display screenshot" = "active display screenshot";
    "all displays screenshot" = "all displays screenshot";
    "region screenshot" = "region screenshot";
    "active window screenshot" = "active window screenshot";
    "record toggle" = "record toggle";
    "replay save" = "replay save";
    "save replay for monitor " = "save replay for monitor ";
    "Unknown time" = "Unknown time";
    "AV1" = "AV1";
    "H.264" = "H.264";
    " · Theme: " = " · Theme: ";

// =============================================================================
//  Luna Capture — QUICK PANEL ESSENTIALS
//  One-press access to the actions you actually use, from inside a game.
// =============================================================================
//
//  WHY THIS IS USEFUL
//
//  The Quick Panel (default Alt + X) is the only Luna surface that reliably
//  works over borderless-fullscreen games. This plugin puts the four actions
//  people reach for most onto that panel and into the tray menu, so you never
//  have to alt-tab to the main window mid-session.
//
//  Quick Panel shows the first three eligible commands and the tray shows the
//  first four, both ordered by the "order" property — lower numbers come first.
//  Re-order the numbers below to choose what makes the cut.
//
//  INSTALL
//    Copy to %LOCALAPPDATA%\Luna Capture\Plugins\ then Plugins -> Reload.
//
// =============================================================================

luna 1;

plugin "luna.base.quick-panel-essentials" {
    name        "Quick Panel Essentials";
    version     "1.0.0";
    author      "Luna Capture";
    description "Region capture, replay save, recording toggle and folder access on the Quick Panel and tray.";
    requires host_api 5;

    permission capture;
    permission replay;
    permission recording;
    permission open_folders;
    permission notifications;
    // Needed only for "quick_panel hide" below: the panel must close before the
    // region editor freezes the desktop, or it ends up inside your screenshot.
    permission ui;

    // --- 1. Grab a region without leaving the game ---------------------------
    command "region" {
        title       "Capture region";
        description "Freeze the desktop and select an area to capture.";
        icon        "region";
        surface     quick_panel;
        surface     tray;
        order       10;
        run {
            quick_panel hide;
            capture region;
        }
    }

    // --- 2. Save the last moments of gameplay --------------------------------
    command "save-replay" {
        title       "Save replay";
        description "Write every buffered Replay channel to disk.";
        icon        "replay";
        surface     quick_panel;
        surface     tray;
        order       20;
        run {
            replay save_all;
        }
    }

    // --- 3. Start or stop a full recording -----------------------------------
    command "toggle-recording" {
        title       "Start / stop recording";
        description "Toggle a normal screen recording.";
        icon        "record";
        surface     quick_panel;
        surface     tray;
        order       30;
        run {
            recording toggle;
        }
    }

    // --- 4. Jump to the output folders ---------------------------------------
    command "open-recordings" {
        title       "Open recordings folder";
        description "Show saved recordings and replays in Explorer.";
        icon        "folder";
        surface     tray;
        order       40;
        run {
            open recordings;
        }
    }

    command "open-screenshots" {
        title       "Open screenshots folder";
        description "Show saved screenshots in Explorer.";
        icon        "photo";
        surface     tray;
        order       50;
        run {
            open screenshots;
        }
    }
}

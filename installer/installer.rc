// Version metadata and icon for LunaSetup.exe. Deliberately separate from the
// app's resources.rc so the installer does not embed the capture sound it never
// plays. Version numbers come from the root VERSION file through CMake.
#include "AppVersionRc.h"

#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif

1 ICON "../assets/lunashot.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_RC_NUMERIC
 PRODUCTVERSION APP_VERSION_RC_NUMERIC
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Luna Capture"
            VALUE "FileDescription", "Luna Capture Setup"
            VALUE "FileVersion", APP_VERSION_ANSI
            VALUE "InternalName", "LunaSetup.exe"
            VALUE "LegalCopyright", "Copyright (c) Luna Capture"
            VALUE "OriginalFilename", "LunaSetup.exe"
            VALUE "ProductName", "Luna Capture"
            VALUE "ProductVersion", APP_VERSION_ANSI
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
